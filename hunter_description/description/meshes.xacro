<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

  <xacro:macro name="mesh" params="name">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/> 
      <geometry>
        <mesh filename="file://$(find hunter_description)/meshes/${name}.dae" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/> 
      <geometry>
        <xacro:if value="${name == 'chassis'}">
          <box size="0.90 0.60 0.30"/>
        </xacro:if>
        <xacro:if value="${name == 'rear_left_wheel'}">
          <cylinder length="0.07" radius="0.165"/>
        </xacro:if>
        <xacro:if value="${name == 'rear_right_wheel'}">
          <cylinder length="0.07" radius="0.165"/>
        </xacro:if>
        <xacro:if value="${name == 'front_left_wheel'}">
          <cylinder length="0.07" radius="0.165"/>
        </xacro:if>
        <xacro:if value="${name == 'front_right_wheel'}">
          <cylinder length="0.07" radius="0.165"/>
        </xacro:if>
      </geometry>
    </collision>
  </xacro:macro>

  <xacro:macro name="virtual">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/> 
      <geometry>
        <cylinder length="0.01" radius="0.01"/>
      </geometry>
      <material name="invisible">
        <color rgba="0.0 0.0 0.0 0.0"/>
      </material>
    </visual>
  </xacro:macro>

  <xacro:macro name="gazebo_friction" params="reference">
    <gazebo reference="${reference}">
      <mu1 value="1.0"/>
      <mu2 value="0.5"/>
      <kp value="10000000.0" />
      <kd value="1.0" />
      <fdir1 value="1 0 0"/>
    </gazebo>
  </xacro:macro>

</robot>